# =============================================================================
# Citation Agent — environment template
# =============================================================================
# Copy to .env.local (never commit .env.local):
#   copy .env.example .env.local
# Then append optional TrustGate vars from .env.local.example if you need scores.
#
# SECRET GUARDRAIL: any value ending in _PRIVATE_KEY, plus SUPABASE_SERVICE_ROLE_KEY
# and AGENT_WALLET_ENCRYPTION_KEY, must NEVER be committed to git, pasted into
# issues/PRs, or shared in chat. If a key is exposed, rotate it immediately.
# =============================================================================

# --- Supabase (publish, royalties UI, agent wallets, comments) ---
# Create a project at https://supabase.com, apply migrations in supabase/migrations/, then:
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
# Use either name — code accepts both (Vercel dashboards often use ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server-only — records payment_events after each x402 settlement. NEVER commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: for scripts/apply-sql-migration.mts and remote push tooling
SUPABASE_PROJECT_REF=your-project-ref
# Optional: Supabase Management API token for apply-sql-migration.mts. NEVER commit.
# SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# --- Site / client ---
NEXT_PUBLIC_SITE_URL=https://agentcitation.xyz
BASE_URL=https://agentcitation.xyz
# WalletConnect / Reown AppKit — allowlist your origin at https://dashboard.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# --- x402 / Circle Gateway payment wallets ---
# Run `npm run generate-wallets` to create seller + buyer pairs into .env.local
# All *_PRIVATE_KEY values are secrets. NEVER commit real keys.
SELLER_ADDRESS=0xYourWalletAddress
SELLER_PRIVATE_KEY=0xYourSellerPrivateKey
# CLI funder only (npm run agent, smoke:full) — NOT shared in-app agent wallets
BUYER_ADDRESS=0xYourBuyerWalletAddress
BUYER_PRIVATE_KEY=0xYourBuyerPrivateKey
# Optional CLI agent Gateway deposit size in USDC (default 1)
# DEPOSIT_AMOUNT=1

# Encrypts per-session agent wallet keys in Supabase (32+ chars; required in production).
# Keep stable across Vercel deploys — changing it strands existing encrypted wallets.
# NEVER commit a real value.
AGENT_WALLET_ENCRYPTION_KEY=your-32-char-or-longer-secret

# --- Arc Testnet ---
ARC_TESTNET_RPC=https://rpc.testnet.arc.network
# Optional browser RPC (defaults to public Arc testnet RPC if unset)
# NEXT_PUBLIC_ARC_TESTNET_RPC=https://rpc.testnet.arc.network
GATEWAY_API=https://gateway-api-testnet.circle.com

# Optional CanteenUSDC wrapper (deploy with `npm run deploy:canteen`)
CANTEEN_USDC_ADDRESS=0xYourCanteenUsdcContractAddress

# Attestation contract (this deployment's verified address; forks must redeploy and override)
ATTESTATION_ADDRESS=0xc8886a68f2160a57a01b32aae542b6eec5ca3d02
NEXT_PUBLIC_ATTESTATION_ADDRESS=0xc8886a68f2160a57a01b32aae542b6eec5ca3d02
ATTESTATION_DEPLOY_BLOCK=48323587

# Immutable platform fee recipient on Attestation.sol — gates operator dashboard APIs
NEXT_PUBLIC_OPERATOR_ADDRESS=0x60C05e2d820CE989E944ED4e7bb33bAEB8705c62
# Optional non-public alias (prefer NEXT_PUBLIC_OPERATOR_ADDRESS)
# OPERATOR_ADDRESS=0xYourOperatorWalletAddress

# Optional: wallet scored for markdown demo seeds (defaults to NEXT_PUBLIC_OPERATOR_ADDRESS)
# MARKETPLACE_IDENTITY_WALLET=0xYourPublisherWallet

# Public "since launch" marketplace metrics (ISO 8601 UTC). Server-side only.
CAMPAIGN_START_TIMESTAMP=2026-06-28T00:00:00Z

# Arcscan API key for contract verification scripts
ARCSCAN_API_KEY=your-arcscan-api-key
# Optional Arcscan base URL for TrustGate wallet-rescore (default testnet.arcscan.app)
# ARCSCAN_BASE=https://testnet.arcscan.app

# --- Script-only private keys (NEVER commit real values) ---
# Attestation deploy: `npm run deploy:attestation` (falls back to BUYER_PRIVATE_KEY if unset)
DEPLOYER_PRIVATE_KEY=0xYourDeployerPrivateKey
# Seed publisher for scripts/publish-research-posts.mts only
PUBLISHER_PRIVATE_KEY=0xYourPublisherPrivateKey

# Circle CLI (agent wallets) — accept terms in CI: CIRCLE_ACCEPT_TERMS=1
# circle wallet list --chain ARC-TESTNET --type agent
