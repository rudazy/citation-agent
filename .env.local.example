# =============================================================================
# Optional TrustGate + scoring layer
# =============================================================================
# After copying .env.example → .env.local, append the block below if you want
# catalog trust badges and paid verify. Without TRUSTGATE_SCORE_API_URL the app
# degrades cleanly (no badges; research agent cites everyone).
#
# SECRET GUARDRAIL: never commit real keys. SCORING_WALLET_* values are not
# secrets but production thresholds — keep them server-only (no NEXT_PUBLIC_).
# =============================================================================

# Free reader — TrustGate arc-score API (raw on-chain points). Server applies wallet-rescore.
# Use {address} as a placeholder, otherwise the wallet is appended as a path segment.
TRUSTGATE_SCORE_API_URL=https://www.trustgated.xyz/api/arc-score/{address}

# Paid lookup — TrustGate oracle PROXY (applies wallet-rescore like the site UI).
# Route through trustgated.xyz/api/oracle, NOT a direct oracle host.
# Server only; never exposed to the client.
TRUSTGATE_ORACLE_URL=https://www.trustgated.xyz/api/oracle/{address}

# Default minimum score for the research agent's --min-trust flag (0 = no filter)
TRUSTGATE_MIN_SCORE=

# Optional timeouts / caches (milliseconds)
# TRUSTGATE_TIMEOUT_MS=12000
# TRUSTGATE_FETCH_CONCURRENCY=4
# TRUSTGATE_CACHE_TTL_MS=300000
# TRUSTGATE_NULL_CACHE_TTL_MS=60000
# TRUSTGATE_PAID_CACHE_TTL_MS=300000

# Wallet-rescore thresholds — REQUIRED on Vercel for accurate badges.
# Without SCORING_WALLET_NON_ELITE_CAP the app shows raw arc-score (often inflated).
# Copy the full block into .env.local / Vercel. Values below are placeholders only.
# SCORING_WALLET_NON_ELITE_CAP=79
# SCORING_WALLET_NON_PERFECT_CAP=
# SCORING_WALLET_HARD_CAP=100
# SCORING_WALLET_BOT_FLAG_PENALTY=
# SCORING_WALLET_BOT_FLAG_HARDCAP_COUNT=
# SCORING_WALLET_VELOCITY_TXS_PER_HOUR=
# SCORING_WALLET_INTERVAL_PATTERN_MIN_SAMPLE=
# SCORING_WALLET_INTERVAL_PATTERN_TOLERANCE=
# SCORING_WALLET_INTERVAL_PATTERN_DOMINANCE=
# SCORING_WALLET_SELF_INTERACTION_THRESHOLD=
# SCORING_WALLET_CLEAN_HISTORY_MIN_TXS=
# SCORING_WALLET_CLEAN_HISTORY_MAX_AGE_DAYS=
# SCORING_WALLET_FRESH_MAX_AGE_DAYS=
# SCORING_WALLET_FRESH_MIN_TXS=
# SCORING_WALLET_HIGH_ELITE_MIN_DEPLOYMENTS=
# SCORING_WALLET_HIGH_ELITE_QUALITY_DEPLOYMENTS=
# SCORING_WALLET_HIGH_ELITE_MIN_ACTIVE_MONTHS=
# SCORING_WALLET_HIGH_ELITE_MIN_CATEGORIES=
# SCORING_WALLET_HIGH_ELITE_MIN_AGE_DAYS=
# SCORING_WALLET_HIGH_ELITE_MIN_TXS=
# SCORING_WALLET_PERFECT_MIN_DEPLOYMENTS=
# SCORING_WALLET_PERFECT_QUALITY_DEPLOYMENTS=
# SCORING_WALLET_PERFECT_MIN_TXS=
# SCORING_WALLET_PERFECT_MIN_AGE_DAYS=
# SCORING_WALLET_CONFIDENCE_HIGH_AGE_DAYS=
# SCORING_WALLET_CONFIDENCE_HIGH_TXS=
# SCORING_WALLET_CONFIDENCE_HIGH_QUALITY_DEPLOYMENTS=
# SCORING_WALLET_CONFIDENCE_LOW_AGE_DAYS=
# SCORING_WALLET_CONFIDENCE_LOW_TXS=

# Optional marketplace notes (also documented in .env.example)
# MARKETPLACE_IDENTITY_WALLET=0xYourPublisherWallet
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id-from-reown-dashboard
